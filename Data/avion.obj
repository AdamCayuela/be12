# Avion low-poly — fuselage +10%, ailes épaissies, dérive affinée
# Axe principal : X  (nez en +X, queue en -X)

mtllib avion.mtl

o avion

# ── Fuselage (+10% sur Y et Z des sections) ──────────────────────────
v  0.5    0.0     0.0      #  1 nez
v  0.32   0.055   0.055    #  2 av-haut-dr
v  0.32  -0.044   0.055    #  3 av-bas-dr
v  0.32  -0.044  -0.055    #  4 av-bas-ga
v  0.32   0.055  -0.055    #  5 av-haut-ga
v  0.0    0.066   0.066    #  6 mi-haut-dr
v  0.0   -0.044   0.066    #  7 mi-bas-dr
v  0.0   -0.044  -0.066    #  8 mi-bas-ga
v  0.0    0.066  -0.066    #  9 mi-haut-ga
v -0.32   0.055   0.055    # 10 ar-haut-dr
v -0.32  -0.033   0.055    # 11 ar-bas-dr
v -0.32  -0.033  -0.055    # 12 ar-bas-ga
v -0.32   0.055  -0.055    # 13 ar-haut-ga
v -0.47   0.044   0.044    # 14 ext-haut-dr
v -0.47  -0.022   0.044    # 15 ext-bas-dr
v -0.47  -0.022  -0.044    # 16 ext-bas-ga
v -0.47   0.044  -0.044    # 17 ext-haut-ga
v -0.58   0.011   0.0      # 18 pointe cône

# ── Ailes (prisme triangulaire, épaisseur ±0.015 en Y) ───────────────
# Aile droite — dessus
v  0.15  -0.005   0.06     # 19 empl-avant-dr haut
v -0.12  -0.005   0.06     # 20 empl-arrière-dr haut
v -0.12  -0.005   0.38     # 21 bout droit haut
# Aile droite — dessous
v  0.15  -0.035   0.06     # 22 empl-avant-dr bas
v -0.12  -0.035   0.06     # 23 empl-arrière-dr bas
v -0.12  -0.035   0.38     # 24 bout droit bas
# Aile gauche — dessus
v  0.15  -0.005  -0.06     # 25 empl-avant-ga haut
v -0.12  -0.005  -0.06     # 26 empl-arrière-ga haut
v -0.12  -0.005  -0.38     # 27 bout gauche haut
# Aile gauche — dessous
v  0.15  -0.035  -0.06     # 28 empl-avant-ga bas
v -0.12  -0.035  -0.06     # 29 empl-arrière-ga bas
v -0.12  -0.035  -0.38     # 30 bout gauche bas

# ── Dérive verticale (parallélépipède balayé) ────────────────────────
v -0.29   0.05   0.015     # 31 BE-bas-dr
v -0.29   0.05  -0.015     # 32 BE-bas-ga
v -0.40   0.23   0.015     # 33 BE-haut-dr  (swept)
v -0.40   0.23  -0.015     # 34 BE-haut-ga  (swept)
v -0.47   0.05   0.015     # 35 BF-bas-dr
v -0.47   0.05  -0.015     # 36 BF-bas-ga
v -0.47   0.23   0.015     # 37 BF-haut-dr
v -0.47   0.23  -0.015     # 38 BF-haut-ga

# ── Stabilisateur horizontal (triangles balayés) ─────────────────────
v -0.29   0.02   0.05      # 39 racine-avant droite
v -0.47   0.02   0.05      # 40 racine-arrière droite
v -0.47   0.02   0.22      # 41 bout droit
v -0.29   0.02  -0.05      # 42 racine-avant gauche
v -0.47   0.02  -0.05      # 43 racine-arrière gauche
v -0.47   0.02  -0.22      # 44 bout gauche

# ─────────────────────────────────────────────────────────────────────
# Faces
# ─────────────────────────────────────────────────────────────────────

usemtl fuselage

# nez
f 1 3 2
f 1 4 3
f 1 5 4
f 1 2 5

# av → milieu
f 2 3 7
f 2 7 6
f 3 4 8
f 3 8 7
f 4 5 9
f 4 9 8
f 5 2 6
f 5 6 9

# milieu → ar
f 6 7 11
f 6 11 10
f 7 8 12
f 7 12 11
f 8 9 13
f 8 13 12
f 9 6 10
f 9 10 13

# ar → extension
f 10 11 15
f 10 15 14
f 11 12 16
f 11 16 15
f 12 13 17
f 12 17 16
f 13 10 14
f 13 14 17

# cône
f 18 14 15
f 18 15 16
f 18 16 17
f 18 17 14

usemtl ailes

# ── Aile droite (prisme triangulaire) ────────────────────────────────
# dessus
f 19 20 21
# dessous
f 22 24 23
# bord avant (emplanture av → bout)
f 19 21 24
f 19 24 22
# racine (emplanture av → emplanture ar)
f 19 22 23
f 19 23 20
# bord de fuite (emplanture ar → bout)
f 20 23 24
f 20 24 21

# ── Aile gauche (prisme triangulaire) ────────────────────────────────
# dessus
f 25 27 26
# dessous
f 28 29 30
# bord avant (emplanture av → bout)
f 25 27 30
f 25 30 28
# racine (emplanture av → emplanture ar)
f 25 28 29
f 25 29 26
# bord de fuite (emplanture ar → bout)
f 26 29 30
f 26 30 27

usemtl derives

# ── Dérive : parallélépipède balayé ──────────────────────────────────
# face droite (+Z)
f 31 35 37
f 31 37 33
# face gauche (-Z)
f 32 34 38
f 32 38 36
# bord d'attaque
f 31 33 34
f 31 34 32
# bord de fuite
f 35 36 38
f 35 38 37
# sommet
f 33 37 38
f 33 38 34
# racine
f 31 32 36
f 31 36 35

# ── Stabilisateur droit (double-face) ────────────────────────────────
f 39 40 41
f 39 41 40

# ── Stabilisateur gauche (double-face) ───────────────────────────────
f 42 44 43
f 42 43 44
